# Copy this file to .env.e2e and fill in the values.
# .env.e2e is gitignored — never commit it.
#
# Used with: docker compose -f docker-compose.e2e.yml --env-file .env.e2e up --build

# --- SQL Server ---
# Source: 1Password, item "LangTeach Docker SA"
SA_PASSWORD=

# --- Auth0 (backend JWT validation + frontend) ---
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.langteach.io
# SPA client ID for the frontend Auth0 provider
VITE_AUTH0_CLIENT_ID=your-spa-client-id

# --- Claude API ---
CLAUDE_API_KEY=

# --- Azure Computer Vision (for OCR image/PDF upload testing) ---
# Leave empty to skip image OCR tests (StubTextExtractor is used in E2ETesting env).
# Get values from Azure Portal -> Computer Vision resource -> Keys and Endpoint.
AZURE_AI_VISION_ENDPOINT=
AZURE_AI_VISION_KEY=

# --- Azure Speech (transcription provider: AzureSpeech) ---
# Only needed when Transcription:Provider=AzureSpeech (not the default).
# Note: e2e stack uses E2ETesting env -> StubTranscriptionService always used regardless.
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=

# --- Azure OpenAI Whisper (transcription provider: AzureOpenAIWhisper, default) ---
# Note: e2e stack uses E2ETesting env -> StubTranscriptionService always used regardless.
# Wired so credentials are available if environment is ever changed for targeted testing.
AZURE_OPENAI_WHISPER_API_KEY=
AZURE_OPENAI_WHISPER_ENDPOINT=
AZURE_OPENAI_WHISPER_DEPLOYMENT_NAME=

# --- Telegram bot ---
# Required to test Telegram webhook flows. Without these, webhook signature auth fails.
# Get values from @BotFather (token) and your webhook secret configuration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- E2E test account (must exist in Auth0) ---
E2E_TEST_EMAIL=test-teacher@example.com
E2E_TEST_PASSWORD=your-test-password
# Auth0 user ID for the test account (used by db-helper.ts for direct SQL cleanup)
# Find it in Auth0 dashboard under Users — format: auth0|xxxxxxxxxxxxxxxxxxxxxxxx
E2E_TEST_AUTH0_USER_ID=auth0|
