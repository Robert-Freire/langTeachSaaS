# Copy this file to .env.qa and fill in the values.
# .env.qa is gitignored — never commit it.
#
# Used with: docker compose -f docker-compose.qa.yml --env-file .env.qa up -d --build
#
# One-time setup:
#   1. Create an Auth0 user for the QA agent (see .claude/skills/teacher-qa/SKILL.md)
#   2. Fill in TEACHER_QA_* fields below
#   3. Install playwright deps: cd .claude/skills/teacher-qa/playwright && npm ci && npx playwright install chromium

# --- SQL Server ---
# Source: 1Password, item "LangTeach Docker SA"
SA_PASSWORD=

# --- Auth0 (backend JWT validation + frontend) ---
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.langteach.io
# SPA client ID for the frontend Auth0 provider
VITE_AUTH0_CLIENT_ID=your-spa-client-id

# --- Claude API ---
CLAUDE_API_KEY=

# --- Azure Computer Vision (for OCR image/PDF upload testing) ---
# Required to test image and scanned-PDF upload in the Redacciones OCR flow.
# Without these, the OCR endpoint fails at DI resolution time (graceful degradation
# is added in #1279). Get values from Azure Portal -> Computer Vision -> Keys and Endpoint.
AZURE_AI_VISION_ENDPOINT=
AZURE_AI_VISION_KEY=

# --- Azure Speech (transcription provider: AzureSpeech) ---
# Only needed when Transcription:Provider=AzureSpeech (not the default).
# Get values from Azure Portal -> Speech resource -> Keys and Endpoint.
AZURE_SPEECH_API_KEY=
AZURE_SPEECH_REGION=

# --- Azure OpenAI Whisper (transcription provider: AzureOpenAIWhisper, default) ---
# Required for real voice-note transcription in QA (Development env uses real provider).
# Without these, the API falls back to StubTranscriptionService and transcription tests
# exercise the stub fixture instead of real Whisper output.
# Get values from Azure Portal -> Azure OpenAI resource (Whisper deployment).
AZURE_OPENAI_WHISPER_API_KEY=
AZURE_OPENAI_WHISPER_ENDPOINT=
AZURE_OPENAI_WHISPER_DEPLOYMENT_NAME=

# --- Telegram bot ---
# Required to test Telegram webhook flows in QA.
# Without these, bot endpoints cannot authenticate webhook signatures.
# Get values from @BotFather (token) and your webhook secret configuration.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Teacher QA dedicated Auth0 account ---
# Created once in Auth0 dashboard — separate from e2e test user so QA data persists.
# Email format suggestion: teacher-qa@langteach.test (or any real email you control)
TEACHER_QA_EMAIL=teacher-qa@example.com
TEACHER_QA_PASSWORD=
# Auth0 user ID — find in Auth0 dashboard under Users, format: auth0|xxxxxxxxxxxxxxxxxxxxxxxx
# Reserved for future direct API seeding (bypassing the browser login for data setup).
# Not read by the current Playwright scripts — they authenticate via the browser login flow.
TEACHER_QA_AUTH0_USER_ID=auth0|
